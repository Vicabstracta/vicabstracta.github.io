---
import { getCollection } from "astro:content";
import { IdToSlug } from "../../utils/hash";
import PostLayout from "../../layouts/PostLayout.astro";
import { render } from "astro:content";
import createSlug from "../../lib/createSlug"

export async function getStaticPaths() {
  const postEntries = await getCollection("posts");
  return postEntries.map((entry) => ({
    // Switch commented code in ...page and ...slug to turn off auto slug generation
    // params: { slug: IdToSlug(entry.id) },
    params: { slug: createSlug(entry.data.title) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

{
  !entry.data.licenseName && (
      <PostLayout
        title={entry.data.title}
        subTitle={entry.data.description}
        bannerImage={entry.data.cover}
        showFeaturedImage={entry.data.showFeaturedImage}
        objectPosition={entry.data.objectPosition}
        published={entry.data.published}
        category={entry.data.category}
        sourceLink={entry.data.sourceLink}
      >
        <div
          class="hidden"
          data-pagefind-body
          data-pagefind-weight="10"
          data-pagefind-meta="title"
        >
          {entry.data.title}
        </div>
        <div data-pagefind-body>
          <Content />
        </div>
      </PostLayout>
  )
}
{
  entry.data.licenseName && (
      <PostLayout
        title={entry.data.title}
        subTitle={entry.data.description}
        bannerImage={entry.data.cover}
        showFeaturedImage={entry.data.showFeaturedImage}
        objectPosition={entry.data.objectPosition}
        published={entry.data.published}
        category={entry.data.category}
        license={{ name: entry.data.licenseName, url: entry.data.licenseUrl }}
        author={entry.data.author}
        sourceLink={entry.data.sourceLink}
      >
      <div
        class="hidden"
        data-pagefind-body
        data-pagefind-weight="10"
        data-pagefind-meta="title"
      >
        {entry.data.title}
      </div>
      <div data-pagefind-body>
        <Content />
      </div>
    </PostLayout>
  )
}
